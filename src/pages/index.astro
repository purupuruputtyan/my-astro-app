---
import Layout from '@/layouts/Layout.astro';
import IconCard from '@/components/astro/ui/IconCard.astro';
import UploadIcon from '@/components/astro/ui/UploadIcon.astro';
import FileImportButton from '@/components/react/ui/FileImportButton';
---

<Layout>
  <main class="p-8">
    <h1 class="mb-6 text-2xl font-bold text-gray-900">Astro</h1>

    <div
      class="flex w-full flex-nowrap items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white p-4"
    >
      <IconCard title="CSVファイルをインポート">
        <UploadIcon slot="icon" label="プラン" />
      </IconCard>

      <FileImportButton
        client:load
        inputId="csv-import"
        accept=".csv"
      />
    </div>
  </main>
</Layout>
