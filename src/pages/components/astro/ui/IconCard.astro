---
type Props = {
  title: string;
};

const { title } = Astro.props;
---

<div class="flex w-full flex-nowrap items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white p-4">
  <div class="flex min-w-0 flex-1 items-center justify-start gap-2">
    <span class="flex shrink-0 items-center justify-center text-gray-700">
      <slot name="icon" />
    </span>

    <span class="truncate text-base font-semibold text-gray-800">
      {title}
    </span>
  </div>

  <div class="ml-4 shrink-0">
    <slot />
  </div>
</div>